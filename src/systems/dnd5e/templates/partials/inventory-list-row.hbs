<article class="row inventory-list-row inventory-list-row-{{sectionId}} inventory-list-row-{{type}}" data-out-of-stock="{{outOfStock}}" data-item-id="{{id}}" data-favorite-context data-state-key="inventory:{{id}}">
  {{#*inline "summary"}}
      <span class="item-icon" aria-hidden="true">
        {{#if icon}}<img src="{{icon}}" alt="">{{else}}{{iconText}}{{/if}}
      </span>
      <span class="row-title sheet-row-title">
        <strong>{{name}}</strong>
        {{#if outOfStock}}<span class="pf-out-of-stock">{{localize 'POCKETFOUNDRY.DND5E.Inventory.Manage.OutOfStock'}}</span>{{/if}}
        <span>{{subtitle}}</span>
      </span>
      {{#each listCells}}
        <span class="sheet-list-value inventory-list-value inventory-list-cell inventory-list-cell-{{id}} {{#if emphasis}}emphasis{{/if}}">
          {{#if adjustment}}
            <button
              class="inventory-number-button"
              type="button"
              data-action="inventory-open-number-dialog"
              data-dialog-id="inventory-number-{{../id}}-{{adjustment.id}}"
              aria-label="{{localize 'POCKETFOUNDRY.Dialog.TitleForName' title=adjustment.title name=../name}}"
              data-swipe-ignore
            >{{value}}</button>
          {{else}}
            {{value}}
          {{/if}}
        </span>
      {{/each}}
      <span class="inventory-list-actions inventory-list-summary-actions" aria-label="{{localize 'POCKETFOUNDRY.DND5E.Inventory.StateForName' name=name}}">
        {{#if actions.canToggleAttuned}}
          <button class="inventory-icon-toggle inventory-summary-attuned attuned {{#if states.attuned}}active{{/if}}" type="button" data-action="inventory-toggle-attuned" data-item-id="{{id}}" aria-label="{{#if states.attuned}}{{localize 'POCKETFOUNDRY.DND5E.Inventory.RemoveAttunementFrom' name=name}}{{else}}{{localize 'POCKETFOUNDRY.DND5E.Inventory.AttuneNamed' name=name}}{{/if}}" aria-pressed="{{#if states.attuned}}true{{else}}false{{/if}}" title="{{localize 'DND5E.AttunementAttuned'}}" data-swipe-ignore>
            <i class="fa-solid fa-sun" aria-hidden="true"></i>
          </button>
        {{else}}
          {{#if states.attuned}}
            <button class="inventory-icon-toggle inventory-summary-attuned attuned active" type="button" data-action="inventory-toggle-attuned" data-item-id="{{id}}" aria-label="{{localize 'POCKETFOUNDRY.DND5E.Inventory.AttunedNamed' name=name}}" aria-pressed="true" title="{{localize 'DND5E.AttunementAttuned'}}" disabled aria-disabled="true" data-swipe-ignore>
              <i class="fa-solid fa-sun" aria-hidden="true"></i>
            </button>
          {{/if}}
        {{/if}}
        <button class="inventory-icon-toggle inventory-summary-equip equipped {{#if states.equipped}}active{{/if}}" type="button" data-action="inventory-toggle-equipped" data-item-id="{{id}}" aria-label="{{#if states.equipped}}{{localize 'POCKETFOUNDRY.DND5E.Inventory.UnequipNamed' name=name}}{{else}}{{localize 'POCKETFOUNDRY.DND5E.Inventory.EquipNamed' name=name}}{{/if}}" aria-pressed="{{#if states.equipped}}true{{else}}false{{/if}}" title="{{localize 'DND5E.Equipped'}}" {{#unless actions.canToggleEquipped}}disabled aria-disabled="true"{{/unless}} data-swipe-ignore>
          <i class="fa-solid fa-shield-halved" aria-hidden="true"></i>
        </button>
        {{#if states.prepared}}<i class="fa-solid fa-certificate" aria-hidden="true"></i>{{/if}}
      </span>
  {{/inline}}
  {{#*inline "body"}}
      {{#if description}}<div class="inventory-description pf-detail-description">{{{description}}}</div>{{/if}}
      {{#if facts.length}}
        <dl class="pf-detail-facts">
          {{#each facts}}
            <div><dt>{{label}}</dt><dd>{{value}}</dd></div>
          {{/each}}
        </dl>
      {{/if}}
      {{#if children.length}}
        <div class="inventory-children">
          <h3>{{localize 'DND5E.Contents'}}</h3>
          {{#each children}}
            <div class="pf-inventory-child-entry">
            <button data-out-of-stock="{{outOfStock}}" class="inventory-child-row" type="button" data-action="inventory-open-item" data-item-uuid="{{uuid}}" data-swipe-ignore>
              <span class="inventory-child-name">{{name}}</span>
              {{#if outOfStock}}<span class="pf-out-of-stock">{{localize 'POCKETFOUNDRY.DND5E.Inventory.Manage.OutOfStock'}}</span>{{/if}}
              <span class="inventory-child-subtitle">{{subtitle}}</span>
              <span class="inventory-child-value">{{localize 'DND5E.Quantity'}} {{quantityLabel}}</span>
              <span class="inventory-child-value">{{localize 'DND5E.Weight'}} {{weightLabel}}</span>
              <span class="inventory-child-value">{{usesLabel}}</span>
            </button>
            {{#if ../actions.canUpdate}}
              <div class="pf-inventory-child-actions">
                <button type="button" data-action="inventory-manage-quantity" data-item-id="{{id}}" data-swipe-ignore>{{localize 'POCKETFOUNDRY.DND5E.Inventory.Manage.StockQuantity'}}</button>
                <button type="button" data-action="inventory-manage-move" data-item-id="{{id}}" data-swipe-ignore>{{localize 'POCKETFOUNDRY.DND5E.Inventory.Manage.MoveTo'}}</button>
                <button type="button" data-action="inventory-manage-delete" data-item-id="{{id}}" data-swipe-ignore>{{localize 'POCKETFOUNDRY.DND5E.Inventory.Manage.Delete'}}</button>
              </div>
            {{/if}}
            </div>
          {{/each}}
        </div>
      {{/if}}
      <div class="inventory-detail-actions pf-detail-actions" aria-label="{{localize 'POCKETFOUNDRY.DND5E.Row.Controls' name=name}}">
        {{#if actions.canTogglePrepared}}<button class="inventory-toggle {{#if states.prepared}}active{{/if}}" type="button" data-action="inventory-toggle-prepared" data-item-id="{{id}}" aria-pressed="{{#if states.prepared}}true{{else}}false{{/if}}" data-swipe-ignore>{{localize 'DND5E.Prepared'}}</button>{{/if}}
        {{#if actions.canRecharge}}<button class="inventory-icon-toggle recharge" type="button" data-action="inventory-recharge" data-item-id="{{id}}" aria-label="{{localize 'POCKETFOUNDRY.DND5E.RechargeNamed' name=name}}" title="{{localize 'DND5E.Recharge'}}" data-swipe-ignore><i class="fa-solid fa-bolt" aria-hidden="true"></i></button>{{/if}}
        {{#if actions.canUpdate}}
          <button type="button" data-action="inventory-manage-move" data-item-id="{{id}}" data-swipe-ignore>{{localize 'POCKETFOUNDRY.DND5E.Inventory.Manage.MoveTo'}}</button>
          {{#if isContainer}}<button type="button" data-action="inventory-manage-edit-bag" data-item-id="{{id}}" data-swipe-ignore>{{localize 'POCKETFOUNDRY.DND5E.Inventory.Manage.EditBag'}}</button>{{/if}}
          <button type="button" data-action="inventory-manage-delete" data-item-id="{{id}}" data-swipe-ignore>{{localize 'POCKETFOUNDRY.DND5E.Inventory.Manage.Delete'}}</button>
        {{/if}}
      </div>
  {{/inline}}
  {{> "modules/pocket-foundry/templates/partials/expandable-detail-row.hbs"
    drawerClass="inventory-detail-drawer"
    summaryClass="inventory-list-row-summary pf-list-schema pf-list-schema--icon-title-3meta-actions"
    bodyClass="pf-expandable-detail-body"
  }}
  {{#each adjustments}}
    {{> "modules/pocket-foundry/templates/partials/number-adjust-dialog.hbs"
      dialogIdPrefix="inventory-number-"
      dialogItemId=../id
      dialogIdMiddle="-"
      dialogAdjustmentId=id
      closeAction="inventory-close-number-dialog"
      title=title
      dialogAriaLabelName=../name
      descriptionName=../name
      descriptionLabel=label
      options=options
      selectAction="inventory-select-delta"
      centerZeroLabel=true
      confirmActionPrefix="inventory-confirm"
      confirmActionMiddle=id
      confirmItemId=../id
    }}
  {{/each}}
  {{> "modules/pocket-foundry/templates/partials/favorite-context-menu.hbs"
    canToggleFavorite=actions.canToggleFavorite
    favorite=favorite
    ariaLabel=name
    addAction="inventory-add-favorite"
    removeAction="inventory-remove-favorite"
    addLabel=(localize 'POCKETFOUNDRY.Favorites.Add')
    removeLabel=(localize 'POCKETFOUNDRY.Favorites.Remove')
    itemId=id
  }}
</article>



