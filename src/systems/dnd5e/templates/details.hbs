{{#if unavailable}}
  {{> "modules/pocket-foundry/templates/partials/pane-unavailable.hbs" region="details-unavailable" title=title body=body}}
{{else}}
  <section class="content details-sheet" data-region="details-pane" data-swipe-region="character-pane">
    <div class="ability-strip" data-region="details-abilities">
      {{#each abilities}}
        <div class="ability-tile" aria-label="{{localize 'POCKETFOUNDRY.DND5E.Details.AbilityCheck' label=label}}">
          <span>{{abbreviation}}</span>
          <strong>{{modifierLabel}}</strong>
          <em>{{value}}</em>
        </div>
      {{/each}}
    </div>

    <div class="details-grid">
      <div class="left-stack">
        <aside class="sheet-panel side-stats" data-region="details-dashboard">
          <div class="hero-number">
            <span>{{localize 'DND5E.ArmorClass'}}</span>
            <strong>{{header.ac}}</strong>
            <em>{{localize 'DND5E.ArmorClass'}}</em>
          </div>
          <div class="diamond-row">
            <div><strong>{{dashboardSummary.initiative}}</strong><span>{{localize 'DND5E.Initiative'}}</span></div>
            <div><strong>{{dashboardSummary.speed}}</strong><span>{{localize 'DND5E.Speed'}}</span></div>
            <div><strong>{{dashboardSummary.proficiency}}</strong><span>{{localize 'DND5E.ProficiencyBonusAbbr'}}</span></div>
          </div>
          <span class="mini-stat death-save-stat death-save-panel">
            <em class="death-save-title">{{localize 'DND5E.DeathSave'}}</em>
            <b class="death-save-pips" aria-label="{{localize 'POCKETFOUNDRY.DND5E.Details.DeathSavesStatus' successes=deathSaves.success failures=deathSaves.failure}}">
              <span class="death-save-label">{{localize 'DND5E.DeathSaveFailures'}}</span>
              {{> "modules/pocket-foundry/templates/partials/fillable-blips.hbs"
                pips=deathSaves.failurePips
                count=3
                direction="rtl"
                fillMode="step"
                color="failure"
                canUpdate=deathSaves.canUpdate
                action="details-death-save-pip"
                kind="failure"
                ariaLabel=(localize 'POCKETFOUNDRY.DND5E.Details.MarkDeathSaveFailure')
              }}
              <i class="fa-solid fa-skull death-save-divider" aria-hidden="true"></i>
              {{> "modules/pocket-foundry/templates/partials/fillable-blips.hbs"
                pips=deathSaves.successPips
                count=3
                direction="ltr"
                fillMode="step"
                color="success"
                canUpdate=deathSaves.canUpdate
                action="details-death-save-pip"
                kind="success"
                ariaLabel=(localize 'POCKETFOUNDRY.DND5E.Details.MarkDeathSaveSuccess')
              }}
              <span class="death-save-label">{{localize 'DND5E.DeathSaveSuccesses'}}</span>
            </b>
          </span>
          <div class="mini-grid">
            <span class="mini-stat"><b>{{dashboardSummary.hitDice}}</b><em>{{localize 'DND5E.HitDice'}}</em></span>
            <span class="mini-stat exhaustion-stat">
              <b class="exhaustion-pips" aria-label="{{localize 'POCKETFOUNDRY.DND5E.Details.ExhaustionLevel' value=exhaustion.value}}">
                {{#each exhaustion.pipGroups}}
                  <span class="pip-group">
                    {{#each this}}
                      <button class="{{#if active}}active{{/if}}" type="button" aria-label="{{localize 'POCKETFOUNDRY.DND5E.Details.SetExhaustionLevel' value=value}}" aria-pressed="{{#if active}}true{{else}}false{{/if}}" data-action="details-exhaustion-pip" data-pip-value="{{value}}" data-pip-active="{{#if active}}true{{else}}false{{/if}}" {{#unless ../../exhaustion.canUpdate}}disabled aria-disabled="true"{{/unless}}></button>
                    {{/each}}
                  </span>
                {{/each}}
              </b>
              <em>{{localize 'DND5E.Exhaustion'}}</em>
            </span>
            {{#if header.xp}}<span class="mini-stat"><b>{{header.xp.value}}</b><em>XP</em></span>{{/if}}
          </div>
          <div class="rest-actions" aria-label="{{localize 'POCKETFOUNDRY.DND5E.Details.RestActions'}}">
            {{#each restActions}}
              <button
                class="rest-action"
                type="button"
                data-action="details-rest"
                data-rest-type="{{type}}"
                aria-label="{{label}}"
                {{#unless canRest}}disabled{{/unless}}
              >
                <i class="{{icon}}" aria-hidden="true"></i>
                <span>{{label}}</span>
              </button>
            {{/each}}
          </div>
          <section id="details-short-rest-dialog" class="mock-dialog" aria-label="{{localize 'DND5E.REST.Short.Label'}}">
            <button class="dialog-backdrop" type="button" data-action="details-close-dialog" aria-label="{{localize 'POCKETFOUNDRY.DND5E.Details.ShortRest.Cancel'}}"></button>
            <div class="rest-dialog-panel" role="dialog" aria-modal="true">
              <h2>{{localize 'DND5E.REST.Short.Label'}}</h2>
              <p>{{localize 'POCKETFOUNDRY.DND5E.Details.ShortRest.Body'}}</p>
              <div class="rest-hp-readout" aria-label="{{localize 'DND5E.HitPointsCurrent'}}">
                <span>{{localize 'DND5E.HitPoints'}}</span>
                <strong>{{shortRest.hpLabel}}</strong>
              </div>
              <div class="rest-hit-dice">
                <span>{{localize 'POCKETFOUNDRY.DND5E.Details.SpendHitDice'}}</span>
                <div class="rest-hit-dice-actions">
                  {{#each shortRest.hitDice}}
                    <button
                      type="button"
                      data-action="details-roll-hit-die"
                      data-denomination="{{denomination}}"
                      aria-label="{{localize 'POCKETFOUNDRY.DND5E.Details.RollHitDie' denomination=denomination}}"
                      {{#if disabled}}disabled{{/if}}
                    >{{label}}</button>
                  {{/each}}
                </div>
              </div>
              {{#unless shortRest.canRollHitDice}}
                <p class="rest-note">{{localize 'POCKETFOUNDRY.DND5E.Details.NoHitDice'}}</p>
              {{/unless}}
              {{#if shortRestLastRoll}}
                <div class="rest-roll-result" role="status" aria-live="polite">
                  <span>{{localize 'POCKETFOUNDRY.DND5E.Details.LastRoll'}}</span>
                  <strong>{{shortRestLastRoll.denomination}}{{#if shortRestLastRoll.total}}: {{shortRestLastRoll.total}}{{/if}}</strong>
                  {{#if shortRestLastRoll.hpDelta}}<em>HP +{{shortRestLastRoll.hpDelta}}</em>{{/if}}
                </div>
              {{/if}}
              <label class="rest-option">
                <input type="checkbox" name="autoHD">
                <span>
                  <strong>{{localize 'POCKETFOUNDRY.DND5E.Details.AutoSpendHitDice'}}</strong>
                  <em>{{localize 'POCKETFOUNDRY.DND5E.Details.AutoSpendHitDiceHint'}}</em>
                </span>
              </label>
              <div class="dialog-actions">
                <button type="button" data-action="details-close-dialog">{{localize 'POCKETFOUNDRY.Action.Cancel'}}</button>
                <button class="primary-action" type="button" data-action="details-confirm-rest" data-rest-type="short">{{localize 'POCKETFOUNDRY.Action.Rest'}}</button>
              </div>
            </div>
          </section>
          <section id="details-long-rest-dialog" class="mock-dialog" aria-label="{{localize 'DND5E.REST.Long.Label'}}">
            <button class="dialog-backdrop" type="button" data-action="details-close-dialog" aria-label="{{localize 'POCKETFOUNDRY.DND5E.Details.LongRest.Cancel'}}"></button>
            <div class="rest-dialog-panel" role="dialog" aria-modal="true">
              <h2>{{localize 'DND5E.REST.Long.Label'}}</h2>
              <p>{{localize 'POCKETFOUNDRY.DND5E.Details.LongRest.Body'}}</p>
              <label class="rest-option">
                <input type="checkbox" name="newDay" checked>
                <span>
                  <strong>{{localize 'DND5E.REST.NewDay.Label'}}</strong>
                  <em>{{localize 'POCKETFOUNDRY.DND5E.Details.NewDayHint'}}</em>
                </span>
              </label>
              <label class="rest-option">
                <input type="checkbox" name="recoverTemp" checked>
                <span>
                  <strong>{{localize 'POCKETFOUNDRY.DND5E.Details.ClearTempHP'}}</strong>
                  <em>{{localize 'POCKETFOUNDRY.DND5E.Details.ClearTempHPHint'}}</em>
                </span>
              </label>
              <label class="rest-option">
                <input type="checkbox" name="recoverTempMax" checked>
                <span>
                  <strong>{{localize 'POCKETFOUNDRY.DND5E.Details.ClearMaxHPModifier'}}</strong>
                  <em>{{localize 'POCKETFOUNDRY.DND5E.Details.ClearMaxHPModifierHint'}}</em>
                </span>
              </label>
              <div class="dialog-actions">
                <button type="button" data-action="details-close-dialog">{{localize 'POCKETFOUNDRY.Action.Cancel'}}</button>
                <button class="primary-action" type="button" data-action="details-confirm-rest" data-rest-type="long">{{localize 'POCKETFOUNDRY.Action.Rest'}}</button>
              </div>
            </div>
          </section>
        </aside>

        <section class="section sheet-group sheet-panel saves-panel" data-region="details-saves">
          <div class="section-heading sheet-group-heading">
            <h2>{{localize 'DND5E.SavingThrow'}}</h2>
          </div>
          <div class="save-grid">
            {{#each saves}}
              <div class="save-item {{#if proficient}}trained{{/if}}" aria-label="{{localize 'POCKETFOUNDRY.DND5E.Details.SavingThrow' label=label}}">
                <span>{{ability}}</span>
                <b>{{totalLabel}}</b>
              </div>
            {{/each}}
          </div>
        </section>
      </div>

      <section class="section sheet-group sheet-panel table-panel" data-region="details-skills">
        <div class="section-heading sheet-group-heading">
          <h2>{{localize 'DND5E.Skills'}}</h2>
        </div>
        <div class="detail-table skills-table">
          <div class="sheet-list-head dnd5e-table-head dnd5e-detail-schema dnd5e-detail-schema--skill" aria-hidden="true">
            <span>{{localize 'DND5E.Ability'}}</span><span>{{localize 'DND5E.Skill'}}</span><span>{{localize 'DND5E.PropertyTotal'}}</span><span>{{localize 'DND5E.Passive'}}</span>
          </div>
          {{#each skills}}
            {{> "modules/pocket-foundry/systems/dnd5e/templates/partials/details-skill-row.hbs" this}}
          {{/each}}
        </div>
      </section>

      <section class="section sheet-group sheet-panel tools-panel" data-region="details-tools">
        <div class="section-heading sheet-group-heading">
          <h2>{{localize 'DND5E.TraitToolProf'}}</h2>
        </div>
        <div class="detail-table tool-table">
          <div class="sheet-list-head dnd5e-table-head dnd5e-detail-schema dnd5e-detail-schema--tool" aria-hidden="true">
            <span>{{localize 'DND5E.Ability'}}</span><span>{{localize 'TYPES.Item.tool'}}</span><span>{{localize 'DND5E.PropertyTotal'}}</span>
          </div>
          {{#each tools}}
            {{> "modules/pocket-foundry/systems/dnd5e/templates/partials/details-tool-row.hbs" this}}
          {{else}}
            <div class="detail-table-row tool-row">
              <span></span><span>-</span><strong>{{localize 'POCKETFOUNDRY.DND5E.Details.NoToolProficiencies'}}</strong><b>-</b>
            </div>
          {{/each}}
        </div>
      </section>

      <section class="sheet-panel traits-panel" data-region="details-traits">
        <div class="trait-groups">
          {{#each traitGroups}}
            {{#if (eq id "armor")}}{{else}}
              {{#if (eq id "weapons")}}{{else}}
                {{#if (eq id "languages")}}{{else}}
                  <section class="trait-group {{#if warning}}warning{{/if}}">
                    <h2>{{label}}</h2>
                    {{#if origin}}
                      <div class="origin-cards">
                        {{#each pills}}
                          {{#if referenceUuid}}
                            {{> "modules/pocket-foundry/templates/partials/pill.hbs"
                              button=true
                              block=true
                              label=label
                              action="document-open-reference"
                              uuid=referenceUuid
                              swipeIgnore=true
                            }}
                          {{else}}
                            {{> "modules/pocket-foundry/templates/partials/pill.hbs"
                              button=true
                              block=true
                              label=label
                              action="document-open-reference"
                              disabled=true
                              swipeIgnore=true
                            }}
                          {{/if}}
                        {{/each}}
                      </div>
                    {{else}}
                      <div class="pill-cluster {{#if warning}}warning-pills{{/if}}">
                        {{#each pills}}
                          {{> "modules/pocket-foundry/templates/partials/pill.hbs" label=label}}
                        {{/each}}
                      </div>
                    {{/if}}
                  </section>
                {{/if}}
              {{/if}}
            {{/if}}
          {{/each}}
          <section class="trait-group proficiency-group">
            <h2>{{localize 'JOURNALENTRYPAGE.DND5E.Class.Traits.Header'}}</h2>
            <div class="proficiency-cluster">
              {{#each traitGroups}}
                {{#if (eq id "armor")}}
                  <section class="proficiency-block">
                    <h3>{{label}}</h3>
                    <div class="pill-cluster">
                      {{#each pills}}
                        {{> "modules/pocket-foundry/templates/partials/pill.hbs" label=label}}
                      {{/each}}
                    </div>
                  </section>
                {{/if}}
              {{/each}}
              {{#each traitGroups}}
                {{#if (eq id "weapons")}}
                  <section class="proficiency-block">
                    <h3>{{label}}</h3>
                    <div class="pill-cluster">
                      {{#each pills}}
                        {{> "modules/pocket-foundry/templates/partials/pill.hbs" label=label}}
                      {{/each}}
                    </div>
                  </section>
                {{/if}}
              {{/each}}
              {{#each traitGroups}}
                {{#if (eq id "languages")}}
                  <section class="proficiency-block">
                    <h3>{{label}}</h3>
                    <div class="pill-cluster">
                      {{#each pills}}
                        {{> "modules/pocket-foundry/templates/partials/pill.hbs" label=label}}
                      {{/each}}
                    </div>
                  </section>
                {{/if}}
              {{/each}}
            </div>
          </section>
        </div>
      </section>
    </div>
  </section>
{{/if}}



