{{#if unavailable}}
  {{> "modules/pocket-foundry/templates/partials/pane-unavailable.hbs" region="inventory-unavailable" title=title body=body}}
{{else}}
  <section class="content sheet-dense inventory-pane" data-region="inventory-pane" data-swipe-region="character-pane">
    <div class="sheet-status" data-region="inventory-status">
      <span>
        <b>{{status.encumbrance.label}}</b>
        <em>{{localize 'DND5E.Encumbrance'}}</em>
        <div class="meter"><span style="width:{{status.encumbrance.pct}}%"></span></div>
      </span>
      <button
        class="inventory-currency-summary{{#unless canUpdate}} is-readonly{{/unless}}"
        type="button"
        {{#if canUpdate}}data-action="inventory-open-currency-dialog" data-dialog-id="inventory-currency-dialog"{{else}}aria-disabled="true"{{/if}}
        data-swipe-ignore
      >
        <b>{{localize 'DND5E.Currency'}}</b>
        <span class="inventory-currency-values" aria-label="{{localize 'POCKETFOUNDRY.DND5E.Inventory.CurrencyTotals'}}">
          {{#each status.currency.values}}
            <span class="inventory-currency-value" data-currency-id="{{id}}">
              <img src="{{icon}}" alt="{{name}}">
              <strong>{{value}}</strong>
            </span>
          {{/each}}
        </span>
      </button>
      <span>
        <b>{{status.attunement.label}}</b>
        <em>{{localize 'DND5E.Attunement'}}</em>
      </span>
    </div>

    {{> "modules/pocket-foundry/templates/partials/pane-search-toolbar.hbs"
    toolbarClass="pane-search-toolbar inventory-toolbar"
    searchClass="pane-search-field inventory-search"
    region="inventory-toolbar"
    placeholder=(localize 'DND5E.InventorySearch')
    ariaLabel=(localize 'DND5E.InventorySearch')
    clearAriaLabel=(localize 'POCKETFOUNDRY.DND5E.Inventory.ClearSearch')
    clearAriaLabel="Clear inventory search"
    value=searchQuery
    pane="Inventory"
    canClear=canClearSearch
    }}

    <div class="inventory-list-view compact-panels" data-region="inventory-list-view">
      {{#each sections}}
        <section class="section sheet-group inventory-section" data-section="{{id}}">
          <div class="section-heading sheet-group-heading inventory-section-heading">
            <h2>{{label}}</h2>
            <span class="chip inventory-section-summary"><span>{{localize 'DND5E.Weight'}}</span><strong>{{weight}}</strong></span>
          </div>
          <div class="sheet-table sheet-list inventory-list">
            {{> "modules/pocket-foundry/systems/dnd5e/templates/partials/table-head.hbs" kind="inventory"}}
            {{#each items}}
              {{> "modules/pocket-foundry/systems/dnd5e/templates/partials/inventory-list-row.hbs" this}}
            {{/each}}
          </div>
        </section>
      {{/each}}
    </div>

    <section id="inventory-currency-dialog" class="mock-dialog inventory-currency-dialog" aria-label="{{localize 'POCKETFOUNDRY.DND5E.Inventory.AdjustCurrency'}}">
      <button class="dialog-backdrop" type="button" data-action="inventory-close-number-dialog" aria-label="{{localize 'POCKETFOUNDRY.DND5E.Inventory.CloseCurrencyDialog'}}"></button>
      <div class="number-spinner inventory-currency-selector-panel" role="dialog" aria-modal="true">
        <h2>{{localize 'POCKETFOUNDRY.DND5E.Inventory.AdjustCurrencyTitle'}}</h2>
        <p>{{localize 'POCKETFOUNDRY.DND5E.Inventory.AdjustCurrencyBody'}}</p>
        <div class="inventory-currency-grid" data-region="inventory-currency-grid">
          {{#each status.currency.values}}
            <section
              class="inventory-currency-trigger"
              data-currency-id="{{id}}"
              data-currency-initial-value="{{value}}"
              data-currency-value="{{value}}"
            >
              <span class="inventory-currency-icon"><img src="{{icon}}" alt=""></span>
              <strong>{{value}}</strong>
              {{> "modules/pocket-foundry/templates/partials/number-adjust-dialog.hbs"
                embeddedWheel=true
                embeddedWheelClass="inventory-currency-wheel"
                title="{{localize 'POCKETFOUNDRY.DND5E.Inventory.AdjustCurrency'}}"
                wheelAriaLabel="Currency value"
                selectAction="inventory-select-currency"
                wheelSelectScope="wheel"
                dynamicWheel=true
                initialValue=0
                chunkSize=20
                step=1
                showSign=true
              }}
            </section>
          {{/each}}
        </div>
        <div class="dialog-actions">
          <button type="button" data-action="inventory-close-number-dialog">{{localize 'POCKETFOUNDRY.Action.Cancel'}}</button>
          <button class="primary-action" type="button" data-action="inventory-apply-currency" data-swipe-ignore>{{localize 'POCKETFOUNDRY.Action.Apply'}}</button>
        </div>
      </div>
    </section>
  </section>
{{/if}}



