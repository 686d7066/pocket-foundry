{{#if unavailable}}
  {{> "modules/pocket-foundry/templates/partials/pane-unavailable.hbs" region="spells-unavailable" title=title body=body}}
{{else}}
  <section class="content sheet-dense spells-pane" data-region="spells-pane" data-swipe-region="character-pane">
    <div class="spell-summary" data-region="spell-summary">
      <div class="spell-stats" data-region="spell-stats">
        {{#each spellcasting}}
          <button class="spellcasting-card {{#if primary}}primary{{/if}}" type="button" data-action="spells-set-primary" data-ability="{{ability}}" {{#unless canSetPrimary}}disabled{{/unless}} data-swipe-ignore>
            <span class="spellcasting-title">{{label}}</span>
            <span class="spellcasting-primary" aria-hidden="true"></span>
            <span><em>{{localize 'DND5E.Ability'}}</em><strong>{{abilityMod}}</strong></span>
            <span><em>{{localize 'DND5E.Attack'}}</em><strong>{{attack}}</strong></span>
            <span><em>{{localize 'DND5E.SpellDC'}}</em><strong>{{save}}</strong></span>
            <span><em>{{localize 'DND5E.Prepared'}}</em><strong>{{prepared}}</strong></span>
          </button>
        {{else}}
          <span><b>{{localize 'POCKETFOUNDRY.DND5E.Spells.NoSpellcasting.Title'}}</b><em>{{localize 'POCKETFOUNDRY.DND5E.Spells.NoSpellcasting.Body'}}</em></span>
        {{/each}}
      </div>
    </div>

    {{> "modules/pocket-foundry/templates/partials/pane-search-toolbar.hbs"
      toolbarClass="pane-search-toolbar spells-toolbar"
      searchClass="pane-search-field spells-search"
      region="spells-toolbar"
      placeholder=(localize 'DND5E.SpellsSearch')
      ariaLabel=(localize 'DND5E.SpellsSearch')
      clearAriaLabel=(localize 'POCKETFOUNDRY.DND5E.Spells.ClearSearch')
      value=searchQuery
      pane="Spells"
      canClear=canClearSearch
    }}

    <div class="compact-panels spell-sections" data-region="spell-sections">
      {{#each sections}}
        <section class="section sheet-group spells-section" data-section="{{id}}" data-method="{{method}}" data-level="{{level}}">
          <div class="section-heading sheet-group-heading spells-section-heading">
            <h2>{{label}}</h2>
            {{#if slotTrack}}
              <div class="slot-tracks spell-section-slots" aria-label="{{localize 'POCKETFOUNDRY.DND5E.Spells.SlotControls' label=label}}" data-region="slot-tracks" data-favorite-context>
                {{#each slotTrack.pips}}
                  <button
                    class="spell-slot-pip {{#if filled}}filled{{/if}} {{#if temporary}}temporary{{/if}}"
                    type="button"
                    data-action="spells-toggle-slot-pip"
                    data-slot="{{../slotTrack.id}}"
                    data-pip="{{n}}"
                    aria-label="{{label}}"
                    aria-pressed="{{#if filled}}true{{else}}false{{/if}}"
                    {{#unless ../slotTrack.canUpdate}}disabled{{/unless}}
                    data-swipe-ignore
                  >
                    <i class="fa-solid fa-shield" aria-hidden="true"></i>
                  </button>
                {{/each}}
                {{> "modules/pocket-foundry/templates/partials/favorite-context-menu.hbs"
                  canToggleFavorite=slotTrack.canToggleFavorite
                  favorite=slotTrack.favorite
                  ariaLabel=slotTrack.label
                  addAction="context-add-favorite"
                  removeAction="context-remove-favorite"
                  addLabel=(localize 'POCKETFOUNDRY.Favorites.Add')
                  removeLabel=(localize 'POCKETFOUNDRY.Favorites.Remove')
                  favoriteType="slots"
                  favoriteId=slotTrack.id
                }}
              </div>
            {{/if}}
          </div>
          <div class="sheet-table sheet-list spells-table">
            <div class="sheet-list-head spells-list-head dnd5e-table-head pf-list-schema pf-list-schema--icon-title-4meta-actions" aria-hidden="true">
              <span>{{localize 'POCKETFOUNDRY.Table.Name'}}</span>
              <span>{{localize 'DND5E.SpellHeader.Time'}}</span>
              <span>{{localize 'DND5E.Range'}}</span>
              <span>{{localize 'DND5E.Target'}}</span>
              <span>{{localize 'DND5E.Roll'}}</span>
              <span></span>
            </div>
            {{#each spells}}
              {{> "modules/pocket-foundry/systems/dnd5e/templates/partials/spell-row.hbs" this}}
            {{else}}
              <div class="feature-card empty-spell-card">
                <strong>{{localize 'POCKETFOUNDRY.DND5E.Spells.NoSectionSpells' label=label}}</strong>
                <p class="mini">{{localize 'POCKETFOUNDRY.DND5E.Spells.EmptySection'}}</p>
              </div>
            {{/each}}
          </div>
        </section>
      {{/each}}
    </div>
  </section>
{{/if}}



