{{#if embeddedWheel}}
  <div class="{{#if embeddedWheelClass}}{{embeddedWheelClass}}{{else}}number-spinner-embedded{{/if}}">
    {{> "modules/pocket-foundry/templates/partials/number-wheel.hbs"}}
  </div>
{{else}}
  <section
    id="{{#if dialogId}}{{dialogId}}{{else}}{{dialogIdPrefix}}{{dialogItemId}}{{dialogIdMiddle}}{{dialogAdjustmentId}}{{dialogIdSuffix}}{{/if}}"
    class="mock-dialog"
    aria-label="{{#if dialogAriaLabel}}{{dialogAriaLabel}}{{else}}{{#if dialogAriaLabelName}}{{localize 'POCKETFOUNDRY.Dialog.TitleForName' title=title name=dialogAriaLabelName}}{{else}}{{title}}{{/if}}{{/if}}"
  >
    <button
      class="dialog-backdrop"
      type="button"
      data-action="{{closeAction}}"
      aria-label="{{#if closeAriaLabel}}{{closeAriaLabel}}{{else}}{{localize 'POCKETFOUNDRY.Action.Close'}}{{/if}}"
    ></button>
    <div class="number-spinner" role="dialog" aria-modal="true">
      <h2>{{title}}</h2>
      <p>
        {{#if description}}
          {{description}}
        {{else}}
          {{#if descriptionName}}{{descriptionName}}{{/if}}{{#if descriptionLabel}}: {{descriptionLabel}}{{/if}}
        {{/if}}
      </p>
      {{> "modules/pocket-foundry/templates/partials/number-wheel.hbs"}}
      <div class="dialog-actions">
        <button type="button" data-action="{{closeAction}}">{{#if cancelLabel}}{{cancelLabel}}{{else}}{{localize 'POCKETFOUNDRY.Action.Cancel'}}{{/if}}</button>
        <button
          class="primary-action"
          type="button"
          data-action="{{confirmActionPrefix}}{{#if confirmActionMiddle}}-{{confirmActionMiddle}}{{/if}}-delta"
          {{#if confirmItemId}}data-item-id="{{confirmItemId}}"{{/if}}
          data-delta="0"
        >{{#if confirmLabel}}{{confirmLabel}}{{else}}{{localize 'POCKETFOUNDRY.Action.OK'}}{{/if}}</button>
      </div>
    </div>
  </section>
{{/if}}
