<main class="pocket-foundry-root mf-app" data-view="settings">
  <header class="mf-header">
    <button class="icon-button" type="button" data-action="back" aria-label="{{localize 'POCKETFOUNDRY.Action.Back'}}">&lt;</button>
    <div class="portrait" aria-hidden="true">PF</div>
    <div class="title-block">
      <h1>{{localize 'POCKETFOUNDRY.Settings.Title'}}</h1>
      <p>{{localize 'POCKETFOUNDRY.Settings.Subtitle'}}</p>
    </div>
  </header>

  <section class="content pf-view">
    {{#> "modules/pocket-foundry/templates/partials/section.hbs"
      id="mobile-mode"
      title=(localize 'POCKETFOUNDRY.Settings.MobileMode.Title')
      sectionClass="pf-view-section"
      headingClass="pf-view-section-heading"
    }}
      {{> "modules/pocket-foundry/templates/partials/settings-toggle-row.hbs"
        label=(localize 'POCKETFOUNDRY.Settings.MobileView.Label')
        hint=(localize 'POCKETFOUNDRY.Settings.MobileView.Hint')
        enabled=mobileViewEnabled
        ariaLabel=(localize 'POCKETFOUNDRY.Settings.MobileView.Label')
        action="toggle-mobile-view"
      }}
      {{> "modules/pocket-foundry/templates/partials/settings-toggle-row.hbs"
        label=(localize 'POCKETFOUNDRY.Settings.ColorBlindMode.Label')
        hint=(localize 'POCKETFOUNDRY.Settings.ColorBlindMode.Hint')
        enabled=colorBlindMode
        ariaLabel=colorBlindModeAriaLabel
        action="toggle-color-blind-mode"
      }}
      {{#if characterSheetBannerAvailable}}
        {{> "modules/pocket-foundry/templates/partials/settings-toggle-row.hbs"
          label=characterSheetBannerLabel
          hint=characterSheetBannerHint
          enabled=characterSheetBannerEnabled
          ariaLabel=characterSheetBannerAriaLabel
          action="toggle-character-banner"
        }}
      {{/if}}
    {{/"modules/pocket-foundry/templates/partials/section.hbs"}}

    {{#> "modules/pocket-foundry/templates/partials/section.hbs"
      id="recents"
      title=(localize 'POCKETFOUNDRY.Recents.Title')
      sectionClass="pf-view-section"
      headingClass="pf-view-section-heading"
    }}
      <div class="setting-row">
        <div>
          <strong>{{localize 'POCKETFOUNDRY.Settings.ClearRecentViews.Label'}}</strong>
          <p class="mini">{{localize 'POCKETFOUNDRY.Settings.ClearRecentViews.Hint'}}</p>
        </div>
        <button
          class="setting-action"
          type="button"
          data-action="clear-recents"
        >{{localize 'POCKETFOUNDRY.Action.Clear'}}</button>
      </div>
    {{/"modules/pocket-foundry/templates/partials/section.hbs"}}

    {{#> "modules/pocket-foundry/templates/partials/section.hbs"
      id="session"
      title=(localize 'POCKETFOUNDRY.Settings.Session.Title')
      sectionClass="pf-view-section"
      headingClass="pf-view-section-heading"
    }}
      <div class="setting-row">
        <div>
          <strong>{{localize 'POCKETFOUNDRY.Settings.LogOut.Label'}}</strong>
          <p class="mini">{{localize 'POCKETFOUNDRY.Settings.LogOut.Hint'}}</p>
        </div>
        <button
          class="setting-action danger-action"
          type="button"
          data-action="logout"
          data-app="logout"
        >{{localize 'POCKETFOUNDRY.Settings.LogOut.Label'}}</button>
      </div>
    {{/"modules/pocket-foundry/templates/partials/section.hbs"}}
  </section>

  {{> "modules/pocket-foundry/templates/partials/bottom-nav.hbs" label=bottomNav.label items=bottomNav.items}}
</main>
