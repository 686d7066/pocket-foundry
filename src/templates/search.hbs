<div class="pf-view search-view">
  <input
    class="search-box"
    type="search"
    value="{{query}}"
    placeholder="{{localize 'POCKETFOUNDRY.Search.Placeholder'}}"
    aria-label="{{localize 'POCKETFOUNDRY.Search.Placeholder'}}"
    data-search-input
    data-action="search-input"
    autocomplete="off"
  >

  <nav class="sub-rail rail search-type-rail" aria-label="{{localize 'POCKETFOUNDRY.Search.TypeFilters'}}">
    {{#each typeFilters}}
      <button
        class="{{#if active}}active{{/if}}"
        type="button"
        data-action="search-type-filter"
        data-type-filter="{{value}}"
        aria-pressed="{{#if active}}true{{else}}false{{/if}}"
      >{{label}}</button>
    {{/each}}
  </nav>

  <div class="section pf-view-section search-results" data-search-results>
    <div class="section-heading pf-view-section-heading">
      <h2>{{localize 'POCKETFOUNDRY.Search.LiveResults'}}</h2>
      {{#if loading}}<span class="mini" role="status">{{localize 'POCKETFOUNDRY.Search.Searching'}}</span>{{/if}}
    </div>

    {{#if errors.length}}
      <div class="empty-state search-error-state" role="status">
        <h2>{{localize 'POCKETFOUNDRY.Search.PartialResults.Title'}}</h2>
        <p>{{localize 'POCKETFOUNDRY.Search.PartialResults.Body'}}</p>
      </div>
    {{/if}}

    {{#if results.length}}
      {{#each results}}
        <a
          class="row search-result-row {{#if focused}}focused{{/if}}"
          href="#"
          role="link"
          tabindex="0"
          data-action="open-search-result"
          data-result-id="{{uuid}}"
          aria-label="{{name}}, {{type}}"
        >
          <span class="item-icon" aria-hidden="true">
            {{#if icon}}<img src="{{icon}}" alt="">{{else}}{{iconText}}{{/if}}
          </span>
          <span class="row-title">
            <strong>{{name}}</strong>
            <span>{{subtitle}}</span>
            {{#if snippet}}<span class="search-snippet">{{snippet}}</span>{{/if}}
          </span>
          <span class="row-action">{{actionLabel}}</span>
        </a>
      {{/each}}
    {{else}}
      {{#if hasUsableQuery}}
        {{#unless loading}}
          {{> "modules/pocket-foundry/templates/partials/empty-state.hbs" title=(localize 'POCKETFOUNDRY.Search.NoResults.Title') body=(localize 'POCKETFOUNDRY.Search.NoResults.Body')}}
        {{/unless}}
      {{else}}
        {{> "modules/pocket-foundry/templates/partials/empty-state.hbs" title=(localize 'POCKETFOUNDRY.Search.Empty.Title') body=(localize 'POCKETFOUNDRY.Search.Empty.Body')}}
      {{/if}}
    {{/if}}
  </div>
</div>
