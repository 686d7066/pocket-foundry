<div class="content pf-view recents-view">
  <div class="section content-group pf-view-section recent-list">
    <div class="section-heading content-group-heading pf-view-section-heading recent-list-heading">
      <h2>{{localize 'POCKETFOUNDRY.Recents.RecentViews'}}</h2>
    </div>

    {{#if hasRows}}
      <div class="content-table content-list pf-view-list recent-list-table" data-table-layout="icon-title-source-actions" role="list">
        <div class="content-list-head recent-list-head" aria-hidden="true">
          <span>{{localize 'POCKETFOUNDRY.Table.View'}}</span>
          <span>{{localize 'POCKETFOUNDRY.Table.Opened'}}</span>
          <span>{{localize 'POCKETFOUNDRY.Table.Action'}}</span>
        </div>

        {{#each rows}}
          {{> "modules/pocket-foundry/templates/partials/content-list-row.hbs"
            rowClass="recent-row"
            rowClassExtra=rowClass
            action="open-recent"
            recentId=id
            recentKind=kind
            icon=icon
            iconText=iconText
            title=title
            subtitle=subtitle
            value=lastOpenedLabel
            valueClass="recent-list-value"
            actionLabel=actionLabel
          }}
        {{/each}}
      </div>
    {{else}}
      {{> "modules/pocket-foundry/templates/partials/empty-state.hbs" title=(localize 'POCKETFOUNDRY.Recents.Empty.Title') body=(localize 'POCKETFOUNDRY.Recents.Empty.Body')}}
    {{/if}}
  </div>
</div>
